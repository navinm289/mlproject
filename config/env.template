# Copy to config/.env and fill in values. Never commit config/.env.
#
# cp config/env.template config/.env

# Databricks workspace URL (AWS) — replace WORKSPACE_ID
DATABRICKS_HOST="https://WORKSPACE_ID.cloud.databricks.com"

# Target job ID from Databricks UI → Workflows → Jobs
DATABRICKS_JOB_ID="123456789012345"

# Service principal or PAT token (store securely on Autosys agent)
DATABRICKS_TOKEN=""

# Service principal display name for setup script
DATABRICKS_SP_NAME="autosys-trigger"

# Autosys agent egress IP (from: curl -s https://ifconfig.me/ip)
AUTOSYS_EGRESS_IP=""

# Optional: corporate proxy
# HTTP_PROXY="http://proxy.example.com:8080"
# HTTPS_PROXY="http://proxy.example.com:8080"
