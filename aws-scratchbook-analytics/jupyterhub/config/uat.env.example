# Copy to config/uat.env and fill in. Sourced by install.sh for the UAT cluster.

ACCOUNT_ID=REPLACE_UAT_ACCOUNT_ID
REGION=us-east-1

LAKE_BUCKET=uat-analytics-lake
EFS_FILE_SYSTEM_ID=fs-REPLACE_UAT_EFS_ID

HMS_NAMESPACE=metastore
HMS_SERVICE=hive-metastore

DOMAIN=jupyter.example.com

OIDC_ISSUER=REPLACE_UAT_OIDC_ISSUER_HOST
OIDC_CLIENT_ID=REPLACE_UAT_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_UAT_OIDC_CLIENT_SECRET

ECR_REPO=REPLACE_UAT_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=1.0.0
