# Copy to config/dev.env and fill in. Sourced by install.sh for the DEV cluster.
# config/*.env is gitignored (contains account-specific values / secrets).

ACCOUNT_ID=REPLACE_DEV_ACCOUNT_ID
REGION=us-east-1

# S3 lakehouse bucket for this environment
LAKE_BUCKET=dev-analytics-lake

# EFS filesystem id backing JupyterHub homes + team shares
EFS_FILE_SYSTEM_ID=fs-REPLACE_DEV_EFS_ID

# HMS (Hive Metastore) service location in this cluster
HMS_NAMESPACE=metastore
HMS_SERVICE=hive-metastore

# DNS suffix; final host becomes <team>.<env>.<DOMAIN>
DOMAIN=jupyter.example.com

# OIDC (IAM Identity Center / Cognito)
OIDC_ISSUER=REPLACE_DEV_OIDC_ISSUER_HOST
OIDC_CLIENT_ID=REPLACE_DEV_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_DEV_OIDC_CLIENT_SECRET

# Notebook image
ECR_REPO=REPLACE_DEV_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=1.0.0
