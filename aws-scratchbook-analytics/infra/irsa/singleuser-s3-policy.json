{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCuratedIceberg",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_LAKE_BUCKET",
        "arn:aws:s3:::REPLACE_LAKE_BUCKET/curated/*",
        "arn:aws:s3:::REPLACE_LAKE_BUCKET/warehouse/*"
      ]
    },
    {
      "Sid": "WriteUserScratchOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_LAKE_BUCKET",
        "arn:aws:s3:::REPLACE_LAKE_BUCKET/scratch/*"
      ]
    }
  ]
}
