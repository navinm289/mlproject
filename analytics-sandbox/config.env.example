# Copy to config.env and fill in. Sourced by helm/install.sh (gitignored once copied).

# AWS
ACCOUNT_ID=REPLACE_ACCOUNT_ID
REGION=us-east-1

# EFS filesystem backing per-user homes (must have efs-sc StorageClass + CSI driver)
EFS_FILE_SYSTEM_ID=fs-REPLACE_EFS_ID

# Public hostname for the hub (needs DNS + ACM cert on the ALB)
HOST=sandbox.example.com

# ACM certificate ARN for the ALB HTTPS listener
ACM_CERT_ARN=arn:aws:acm:us-east-1:REPLACE_ACCOUNT_ID:certificate/REPLACE_CERT_ID

# OIDC (Amazon Cognito by default; swap issuer URLs for IAM Identity Center)
# For Cognito: OIDC_ISSUER=<pool-domain>.auth.<region>.amazoncognito.com
OIDC_ISSUER=REPLACE_COGNITO_DOMAIN.auth.us-east-1.amazoncognito.com
OIDC_CLIENT_ID=REPLACE_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_OIDC_CLIENT_SECRET

# Base notebook image (Phase 1 uses upstream jupyter/base-notebook directly).
# In Phase 2 point this at your ECR image once you add libs/Spark.
SINGLEUSER_IMAGE=jupyter/base-notebook
SINGLEUSER_IMAGE_TAG=python-3.11
